    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ model: 'gemma2-9b-it', messages: [{ role: 'user', content: 'You are a data governance classifier. Classify the given RESPONSE and return a JSON object with two fields: classification and domain.\\n\\nclassification must be one of: SENSITIVE, STANDARD, UNCERTAIN\\n- SENSITIVE: response contains PII, financial data, strategic roadmap, credentials, legal advice, medical info, or individual-specific HR actions\\n- STANDARD: response contains no sensitive information\\n- UNCERTAIN: response spans multiple sensitive categories, is ambiguous, or cannot be confidently classified as SENSITIVE or STANDARD. UNCERTAIN is a valid and expected output, not a failure state.\\n\\ndomain must be one of: PII, FINANCIALS, STRATEGIC, CREDENTIALS, LEGAL, MEDICAL, HR, NAMED_INDIVIDUAL, NONE\\nChoose the single most relevant domain. Use NONE if classification is STANDARD.\\n\\nResponse to classify: ' + $('Strip Markdown').item.json.cleanResponse }], temperature: 0, max_tokens: 60, response_format: { type: 'json_object' } }) }}",
        "options": {
          "timeout": 30000
        }
