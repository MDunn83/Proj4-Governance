    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ model: 'gemma2-9b-it', messages: [{ role: 'user', content: 'Answer the following question in plain text only. Do not use markdown, bullet points, headers, bold, italic, or any formatting. Write in plain prose sentences only.\\n\\nQuestion: ' + $json['Query'] }], temperature: 0.7, max_tokens: 512 }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "node-generate-response",
      "name": "Generate Response",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "2",
          "name": "Groq API"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = ($json.choices[0].message.content || '').toString();\nlet text = raw;\n// Remove fenced code blocks\ntext = text.replace(/```[\\s\\S]*?```/g, '');\n// Remove inline code\ntext = text.replace(/`([^`]+)`/g, '$1');\n// Remove ATX headers\ntext = text.replace(/^#{1,6}\\s+/gm, '');\n// Remove bold and italic\ntext = text.replace(/\\*{1,3}([^*\\n]+)\\*{1,3}/g, '$1');\ntext = text.replace(/_{1,3}([^_\\n]+)_{1,3}/g, '$1');\n// Remove unordered list markers\ntext = text.replace(/^[\\*\\-\\+]\\s+/gm, '');\n// Remove ordered list markers\ntext = text.replace(/^\\d+\\.\\s+/gm, '');\n// Remove horizontal rules\ntext = text.replace(/^[\\-\\*_]{3,}\\s*$/gm, '');\n// Collapse excess blank lines\ntext = text.replace(/\\n{3,}/g, '\\n\\n');\ntext = text.trim();\nreturn { json: { cleanResponse: text, usage: $json.usage } };"
      },
      "id": "node-strip-markdown",
      "name": "Strip Markdown",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ model: 'gemma2-9b-it', messages: [{ role: 'user', content: 'You are a data governance classifier. Classify the given QUERY and return a JSON object with two fields: classification and domain.\\n\\nclassification must be one of: SENSITIVE, STANDARD, UNCERTAIN\\n- SENSITIVE: query contains or requests PII, financial data, strategic roadmap, credentials, legal advice, medical info, or individual-specific HR actions\\n- STANDARD: query contains or requests no sensitive information\\n- UNCERTAIN: query spans multiple sensitive categories, is ambiguous, or cannot be confidently classified as SENSITIVE or STANDARD\\n\\ndomain must be one of: PII, FINANCIALS, STRATEGIC, CREDENTIALS, LEGAL, MEDICAL, HR, NAMED_INDIVIDUAL, NONE\\nChoose the single most relevant domain. Use NONE if classification is STANDARD.\\n\\nQuery to classify: ' + $('Set Start Time').item.json['Query'] }], temperature: 0, max_tokens: 60, response_format: { type: 'json_object' } }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "node-classify-query",
      "name": "Classify Query",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 300],
